---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Avatar from '../components/Avatar.astro';
import { getVault } from '../lib/vault';
import { renderNote } from '../lib/markdown';
import { siteConfig } from '../../site.config';
import { formatCount, withBase } from '../lib/utils';
import { icon } from '../lib/icons';

const vault = getVault();
const page = vault.pages.find((p) => siteConfig.content.pages[p.id] === '/about/');
const rendered = page ? await renderNote(page) : null;
const { github, email, twitter } = siteConfig.social;
const posts = vault.chronological;
const since = posts.at(-1)?.date.getUTCFullYear();
const words = posts.reduce((s, p) => s + p.words, 0);
---

<BaseLayout title={page?.title ?? '关于'} description={siteConfig.bio || page?.description}>
  <div class="about container">
    <header class="about-header">
      <Avatar size={96} class="about-avatar" />
      <div class="about-id">
        <p class="eyebrow">关于我</p>
        <h1>{siteConfig.author}</h1>
        {siteConfig.bio && <p class="about-bio">{siteConfig.bio}</p>}
        <div class="about-links">
          {github && <a class="btn" href={github} target="_blank" rel="noopener me"><Fragment set:html={icon('github', 16)} /> GitHub</a>}
          {twitter && <a class="btn" href={twitter} target="_blank" rel="noopener me"><Fragment set:html={icon('twitter', 16)} /> X</a>}
          {email && <a class="btn" href={`mailto:${email}`}><Fragment set:html={icon('mail', 16)} /> 邮件</a>}
          <a class="btn" href={withBase('/rss.xml')}><Fragment set:html={icon('rss', 16)} /> 订阅</a>
        </div>
      </div>
    </header>

    {
      posts.length > 0 && (
        <dl class="about-stats">
          {since && (
            <div>
              <dt>开始写作</dt>
              <dd>{since}</dd>
            </div>
          )}
          <div>
            <dt>文章</dt>
            <dd>{posts.length}</dd>
          </div>
          <div>
            <dt>字数</dt>
            <dd>{formatCount(words)}</dd>
          </div>
          <div>
            <dt>标签</dt>
            <dd>{vault.tags().length}</dd>
          </div>
        </dl>
      )
    }

    <div class="article-content" data-article-content>
      {rendered ? <Prose html={rendered.html} /> : <p class="empty-state">在 content/about.md 中写下自我介绍。</p>}
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: calc(720px + var(--gutter) * 2);
  }
  .about-header {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-block: clamp(48px, 8vw, 96px) 32px;
  }
  .about-header :global(.about-avatar) {
    transform: rotate(-4deg);
    box-shadow: var(--shadow-md);
  }
  .about-id h1 {
    margin-top: 6px;
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .about-bio {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--fg-muted);
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .about-links .btn {
    height: 34px;
    padding: 0 13px;
    font-size: 13.5px;
  }
  .about-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1px;
    margin-bottom: 48px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .about-stats > div {
    padding: 16px 20px;
    background: var(--bg);
  }
  .about-stats dt {
    font-size: 12.5px;
    color: var(--fg-faint);
  }
  .about-stats dd {
    margin-top: 2px;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 560px) {
    .about-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>
